# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and is loaded by `next dev`, `drizzle-kit`, and
# the seed script.

# --- Application database ---------------------------------------------------

# Runtime connection used by the app. On Neon use the *pooled* endpoint.
DATABASE_URL=postgres://app:app@localhost:5432/app

# Migrations only (never used at runtime). On Neon use the *direct/unpooled*
# endpoint. Falls back to DATABASE_URL when unset.
DATABASE_URL_UNPOOLED=postgres://app:app@localhost:5432/app

# Read replica connection. On Neon use the replica's *pooled* endpoint.
# Falls back to DATABASE_URL when unset (no replica).
DATABASE_REPLICA_URL=postgres://app:app@localhost:5432/app

# --- Read cache (Upstash Redis) ----------------------------------------------
# Optional: when unset, the read cache is disabled and every read falls
# through to the database (local dev, Docker, and unit tests run fine
# without it). On Vercel, create the database in the SAME region as the
# Vercel functions and Neon project (Tokyo) — e.g. via the Vercel
# Marketplace. See lib/redis.ts and lib/cache.ts.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Docker Compose (local Postgres container) ------------------------------
# These are only used by compose.yaml and already have sensible defaults.

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# --- App secrets ------------------------------------------------------------


